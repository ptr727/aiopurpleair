# Normalize every detected text file to LF in the index and on checkout.
# `text=auto` leaves binary files byte-preserved.
# Mirrors `.editorconfig`, which governs what the editor writes where this governs what git stores.
# git config --global core.autocrlf false
# git add --renormalize .
# git ls-files --eol
* text=auto eol=lf

# Windows command scripts require CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
