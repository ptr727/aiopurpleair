# https://editorconfig.org

# Root config
root = true

# Defaults: LF is the default, and only the CRLF exception below is declared.
# Windows GUI editors read and write LF cleanly, and the toolchain (uv, ruff, Dependabot, Actions)
# already produces LF, so a CRLF default only churned against tooling that normalized it back.
# `.gitattributes` mirrors these two defaults as git's normalization fallback.
# CI verifies the committed bytes against this file (editorconfig-checker).
[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

# Markdown files - trailing whitespace is significant (hard line breaks)
[*.md]
trim_trailing_whitespace = false

# YAML files
[*.{yml,yaml}]
indent_size = 2

# Windows batch and command scripts: the one CRLF exception to the `[*]` LF default above.
# This repo ships none today, and the block is carried so the exception is declared where a reader looks for it.
[*.{bat,cmd}]
end_of_line = crlf
