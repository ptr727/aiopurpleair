{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Ruff Check",
            "type": "process",
            "command": "uv",
            "args": [
                "run",
                "ruff",
                "check"
            ],
            "problemMatcher": [],
            "presentation": {
                "showReuseMessage": false,
                "clear": false
            }
        },
        {
            "label": "Ruff Format Check",
            "type": "process",
            "command": "uv",
            "args": [
                "run",
                "ruff",
                "format",
                "--check"
            ],
            "problemMatcher": [],
            "presentation": {
                "showReuseMessage": false,
                "clear": false
            }
        },
        {
            "label": "Mypy",
            "type": "process",
            "command": "uv",
            "args": [
                "run",
                "mypy",
                "src"
            ],
            "problemMatcher": [],
            "presentation": {
                "showReuseMessage": false,
                "clear": false
            }
        },
        {
            "label": "Pyright",
            "type": "process",
            "command": "uv",
            "args": [
                "run",
                "pyright"
            ],
            "problemMatcher": [],
            "presentation": {
                "showReuseMessage": false,
                "clear": false
            }
        },
        {
            "label": "Lint: ruff + mypy + pyright (verify)",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Ruff Check",
                "Ruff Format Check",
                "Mypy",
                "Pyright"
            ],
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": []
        },
        {
            "label": "Ruff Format",
            "type": "process",
            "command": "uv",
            "args": [
                "run",
                "ruff",
                "format"
            ],
            "problemMatcher": [],
            "presentation": {
                "showReuseMessage": false,
                "clear": false
            }
        },
        {
            "label": "Ruff Check Fix",
            "type": "process",
            "command": "uv",
            "args": [
                "run",
                "ruff",
                "check",
                "--fix"
            ],
            "problemMatcher": [],
            "presentation": {
                "showReuseMessage": false,
                "clear": false
            }
        },
        {
            "label": "Fix: ruff format + check --fix",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Ruff Format",
                "Ruff Check Fix"
            ],
            "problemMatcher": []
        },
        {
            "label": "Test: pytest",
            "type": "process",
            "command": "uv",
            "args": [
                "run",
                "pytest"
            ],
            "group": { "kind": "test", "isDefault": true },
            "problemMatcher": [],
            "presentation": {
                "showReuseMessage": false,
                "clear": false
            }
        },
        {
            "label": "Test: pytest (update snapshots)",
            "type": "process",
            "command": "uv",
            "args": [
                "run",
                "pytest",
                "--snapshot-update"
            ],
            "problemMatcher": [],
            "presentation": {
                "showReuseMessage": false,
                "clear": false
            }
        },
        // Lint group, run on demand.
        // The EditorConfig, Workflows, Markdown, and Spelling tasks go through the hub's scripts/docker_lint.py, fetched by hub_fetch_run.py.
        // Each container therefore sees a read-only snapshot of the tracked and unignored files, with no network.
        // It mirrors the CI lint gate.
        // Broad live spell-checking is the cspell extension's job.
        // Pre-commit already runs the prose gate diff-scoped and the EOL gate over the whole tree.
        // Lint: Prose below adds the prose gate in whole-repo mode, and Lint: EOL runs the hook's own EOL check on demand.
        // Every Lint task is language-agnostic, the same check as in the .NET snippet's Lint group.
        {
            "label": "Lint: EditorConfig",
            "type": "process",
            "command": "uv",
            "args": [ "run", "--no-project", "python", "${workspaceFolder}/hub_fetch_run.py", "scripts/docker_lint.py", "--linter", "editorconfig-checker" ],
            "problemMatcher": [],
            "presentation": {
                "showReuseMessage": false,
                "clear": false
            }
        },
        {
            "label": "Lint: Workflows",
            "type": "process",
            "command": "uv",
            "args": [ "run", "--no-project", "python", "${workspaceFolder}/hub_fetch_run.py", "scripts/docker_lint.py", "--linter", "actionlint" ],
            "problemMatcher": [],
            "presentation": {
                "showReuseMessage": false,
                "clear": false
            }
        },
        {
            "label": "Lint: Markdown",
            "type": "process",
            "command": "uv",
            "args": [ "run", "--no-project", "python", "${workspaceFolder}/hub_fetch_run.py", "scripts/docker_lint.py", "--linter", "markdownlint" ],
            "problemMatcher": [],
            "presentation": {
                "showReuseMessage": false,
                "clear": false
            }
        },
        {
            "label": "Lint: Spelling",
            "type": "process",
            "command": "uv",
            "args": [ "run", "--no-project", "python", "${workspaceFolder}/hub_fetch_run.py", "scripts/docker_lint.py", "--linter", "cspell" ],
            "problemMatcher": [],
            "presentation": {
                "showReuseMessage": false,
                "clear": false
            }
        },
        {
            "label": "Lint: Prose",
            "type": "process",
            "command": "uv",
            "args": [ "run", "--no-project", "python", "${workspaceFolder}/hub_fetch_run.py", ".github/actions/prose-gate/prose_lint.py", "." ],
            "problemMatcher": [],
            "presentation": {
                "showReuseMessage": false,
                "clear": false
            }
        },
        {
            "label": "Lint: EOL",
            "type": "process",
            "command": "uv",
            "args": [ "run", "--no-project", "python", "${workspaceFolder}/hub_fetch_run.py", ".github/actions/repo-gate/repo_gate.py", "--check", "eol" ],
            "problemMatcher": [],
            "presentation": {
                "showReuseMessage": false,
                "clear": false
            }
        },
        {
            "label": "Lint: All",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Lint: EditorConfig",
                "Lint: Workflows",
                "Lint: Markdown",
                "Lint: Spelling",
                "Lint: Prose",
                "Lint: EOL"
            ],
            "problemMatcher": []
        }
    ]
}
